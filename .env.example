# Trello API credentials (required for all transport modes)
# Get your API key from: https://trello.com/power-ups/admin
# Generate a token from the same page
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Server password for OAuth login (required for HTTP transport only)
# Set this to any strong password — used to authenticate via the browser login form
MCP_AUTH_TOKEN=your_server_password

# Server configuration (optional, defaults shown)
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=0.0.0.0
